# LeadConnector (GoHighLevel) – Inbound Webhook URL jednotlivých workflow
VITE_LC_WEBHOOK_AUDIT=
VITE_LC_WEBHOOK_CALC=
VITE_LC_WEBHOOK_PREP=
VITE_LC_WEBHOOK_CONTACT=
VITE_LC_WEBHOOK_MATERIAL=
# LeadConnector kalendáře (URL widgetu, např. https://api.leadconnectorhq.com/widget/booking/XXXX)
VITE_LC_CALENDAR_AUDIT=
VITE_LC_CALENDAR_INTRO=
# Videa (embed URL, např. https://www.youtube-nocookie.com/embed/ID nebo Vimeo/Wistia embed)
VITE_VSL_URL=
VITE_TY_VIDEO_URL=
# Google Tag Manager (GTM-XXXXXXX). Načte se až po souhlasu s cookies.
VITE_GTM_ID=
# Veřejná adresa webu pro canonical a OG
VITE_SITE_URL=https://www.boostia.cz
# true = zobrazí štítky [PROOF/DOPLNIT/OVĚŘIT] na webu. Před ostrým spuštěním nastavte false.
VITE_SHOW_PLACEHOLDERS=true
