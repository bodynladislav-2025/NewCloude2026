{
  "rewrites": [{ "source": "/((?!assets/|materialy/|.*\\..*).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/dekujeme(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
